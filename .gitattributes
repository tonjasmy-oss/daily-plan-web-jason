# Shell 脚本必须永远保持 LF 换行, 否则在 Linux 上会报 "\r: command not found"
*.sh text eol=lf
deploy-cloud.sh text eol=lf

# Windows 批处理需要 CRLF
*.bat text eol=crlf

# 二进制文件不做换行转换
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
